generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RemoteType {
  ONSITE
  HYBRID
  REMOTE
}

enum JobStatus {
  WISHLIST
  APPLIED
  PHONE_SCREEN
  INTERVIEW
  OFFER
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum InterviewType {
  PHONE
  VIDEO
  ONSITE
  TAKEHOME
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum DocumentType {
  RESUME
  COVER_LETTER
  PORTFOLIO
  OTHER
}

enum ActivityType {
  NOTE
  STATUS_CHANGE
  EMAIL_SENT
  INTERVIEW_SCHEDULED
  DOCUMENT_ADDED
  REMINDER_CREATED
}

enum TemplateType {
  EMAIL
  COVER_LETTER
  FOLLOW_UP
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique @db.VarChar(320)
  passwordHash String
  name         String       @db.VarChar(120)
  avatarUrl    String?
  timezone     String       @default("UTC") @db.VarChar(80)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  companies    Company[]
  jobs         Job[]
  contacts     Contact[]
  documents    Document[]
  activities   Activity[]
  templates    Template[]
}

model Company {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(200)
  website   String?
  industry  String?   @db.VarChar(120)
  size      String?   @db.VarChar(80)
  location  String?   @db.VarChar(200)
  notes     String?   @db.Text
  logoUrl   String?
  userId    String    @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs      Job[]
  contacts Contact[]

  @@index([userId])
  @@index([name])
}

model Job {
  id             String      @id @default(uuid()) @db.Uuid
  title          String      @db.VarChar(200)
  description    String?     @db.Text
  url            String?
  salaryMin      Decimal?    @db.Decimal(12, 2)
  salaryMax      Decimal?    @db.Decimal(12, 2)
  salaryCurrency String?     @default("USD") @db.VarChar(3)
  location       String?     @db.VarChar(200)
  remoteType     RemoteType?
  status         JobStatus   @default(WISHLIST)
  priority       Priority    @default(MEDIUM)
  appliedAt      DateTime?
  companyId      String      @db.Uuid
  userId         String      @db.Uuid
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  company        Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  interviews     Interview[]
  documents      Document[]
  activities     Activity[]
  reminders      Reminder[]

  @@index([userId, status])
  @@index([companyId])
  @@index([appliedAt])
}

model Interview {
  id          String            @id @default(uuid()) @db.Uuid
  type        InterviewType
  scheduledAt DateTime
  duration    Int               @default(60)
  location    String?
  notes       String?           @db.Text
  status      InterviewStatus   @default(SCHEDULED)
  jobId       String            @db.Uuid
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  job         Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  contacts    Contact[]

  @@index([jobId])
  @@index([scheduledAt])
}

model Contact {
  id        String      @id @default(uuid()) @db.Uuid
  name      String      @db.VarChar(160)
  role      String?     @db.VarChar(160)
  email     String?     @db.VarChar(320)
  phone     String?     @db.VarChar(50)
  linkedin  String?
  notes     String?     @db.Text
  companyId String      @db.Uuid
  userId    String      @db.Uuid
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  interviews Interview[]

  @@index([userId])
  @@index([companyId])
  @@index([email])
}

model Document {
  id        String       @id @default(uuid()) @db.Uuid
  name      String       @db.VarChar(255)
  type      DocumentType @default(OTHER)
  url       String
  fileSize  Int
  mimeType  String       @db.VarChar(120)
  isDefault Boolean      @default(false)
  userId    String       @db.Uuid
  jobId     String?      @db.Uuid
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job?         @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([jobId])
}

model Activity {
  id        String       @id @default(uuid()) @db.Uuid
  type      ActivityType
  content   String       @db.Text
  metadata  Json?
  userId    String       @db.Uuid
  jobId     String?      @db.Uuid
  createdAt DateTime     @default(now())

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job?         @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([jobId, createdAt])
}

model Reminder {
  id        String   @id @default(uuid()) @db.Uuid
  title     String   @db.VarChar(255)
  dueAt     DateTime
  completed Boolean  @default(false)
  jobId     String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([dueAt, completed])
}

model Template {
  id        String       @id @default(uuid()) @db.Uuid
  name      String       @db.VarChar(200)
  subject   String?      @db.VarChar(255)
  body      String       @db.Text
  type      TemplateType
  variables String[]
  userId    String       @db.Uuid
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}
