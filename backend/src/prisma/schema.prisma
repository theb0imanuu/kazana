// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RemoteType {
  ONSITE
  HYBRID
  REMOTE
}

enum JobStatus {
  WISHLIST
  APPLIED
  PHONE_SCREEN
  INTERVIEW
  OFFER
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum InterviewType {
  PHONE
  VIDEO
  ONSITE
  TAKEHOME
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum DocumentType {
  RESUME
  COVER_LETTER
  PORTFOLIO
  OTHER
}

enum ActivityType {
  NOTE
  STATUS_CHANGE
  EMAIL_SENT
  INTERVIEW_SCHEDULED
  DOCUMENT_ADDED
  REMINDER_CREATED
}

enum TemplateType {
  EMAIL
  COVER_LETTER
  FOLLOW_UP
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String
  name         String
  avatarUrl    String?
  timezone     String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  companies    Company[]
  jobs         Job[]
  contacts     Contact[]
  documents    Document[]
  activities   Activity[]
  templates    Template[]

  @@map("users")
}

model Company {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  website   String?
  industry  String?
  size      String?
  location  String?
  notes     String?   @db.Text
  logoUrl   String?
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs      Job[]
  contacts  Contact[]

  @@index([userId])
  @@map("companies")
}

model Job {
  id             String       @id @default(uuid()) @db.Uuid
  title          String
  description    String?      @db.Text
  url            String?
  salaryMin      Decimal?     @db.Decimal(12, 2)
  salaryMax      Decimal?     @db.Decimal(12, 2)
  salaryCurrency String?
  location       String?
  remoteType     RemoteType
  status         JobStatus
  priority       Priority
  appliedAt      DateTime?
  companyId      String?      @db.Uuid
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId         String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  interviews     Interview[]
  documents      Document[]
  activities     Activity[]
  reminders      Reminder[]

  @@index([userId])
  @@index([companyId])
  @@index([status])
  @@map("jobs")
}

model Interview {
  id          String          @id @default(uuid()) @db.Uuid
  type        InterviewType
  scheduledAt DateTime
  duration    Int?
  location    String?
  notes       String?         @db.Text
  status      InterviewStatus
  jobId       String          @db.Uuid
  job         Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("interviews")
}

model Contact {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  role      String?
  email     String?
  phone     String?
  linkedin  String?
  notes     String?  @db.Text
  companyId String?  @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([companyId])
  @@map("contacts")
}

model Document {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  type      DocumentType
  url       String
  fileSize  Int?
  mimeType  String?
  isDefault Boolean      @default(false)
  userId    String       @db.Uuid
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String?      @db.Uuid
  job       Job?         @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([jobId])
  @@map("documents")
}

model Activity {
  id       String       @id @default(uuid()) @db.Uuid
  type     ActivityType
  content  String?      @db.Text
  metadata Json?
  userId   String       @db.Uuid
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId    String?      @db.Uuid
  job      Job?         @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([jobId])
  @@map("activities")
}

model Reminder {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  dueAt     DateTime
  completed Boolean  @default(false)
  jobId     String   @db.Uuid
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("reminders")
}

model Template {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  subject   String?
  body      String       @db.Text
  type      TemplateType
  variables String[]
  userId    String       @db.Uuid
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("templates")
}
